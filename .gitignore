.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# IDE and editor configurations
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.temp
.cache/

# Local databases
*.sqlite
*.sqlite3
*.db

# Generated Python files
*.pyo
